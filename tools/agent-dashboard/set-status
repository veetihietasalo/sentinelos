#!/usr/bin/env python3
"""Atomically update one agent's status in status.json, appending to its activity flow.

Usage:
  set-status <agent-name> <idle|working|blocked|done> [task words...]
  set-status <agent-name> log <message words...>     # append a flow line WITHOUT changing status

Optional flags (may appear anywhere after the verb):
  --tokens N       Set the agent's top-level `tokens` field to integer N.
  --commit HASH    Attach `"commit": HASH` to the new history entry and set
                   the agent's top-level `commit` field to HASH.

Every call appends a timestamped entry to the agent's `history` array (capped),
which the dashboard renders as that agent's expandable "output flow".
"""

import json
import os
import sys
import tempfile
import datetime

VALID_STATUSES = {"idle", "working", "blocked", "done"}
HISTORY_CAP = 40  # keep the most recent N flow entries per agent

def main():
    if len(sys.argv) < 3:
        print("Usage: set-status <agent-name> <idle|working|blocked|done|log> [words...] [--tokens N] [--commit HASH]", file=sys.stderr)
        sys.exit(1)

    agent_name = sys.argv[1]
    verb = sys.argv[2]
    raw_args = sys.argv[3:]

    # Parse optional --tokens and --commit flags from anywhere in raw_args
    tokens = None
    commit_hash = None
    remaining = []
    i = 0
    while i < len(raw_args):
        if raw_args[i] == "--tokens" and i + 1 < len(raw_args):
            try:
                tokens = int(raw_args[i + 1])
            except ValueError:
                print(f"Error: --tokens requires an integer, got: {repr(raw_args[i + 1])}", file=sys.stderr)
                sys.exit(1)
            i += 2
        elif raw_args[i] == "--commit" and i + 1 < len(raw_args):
            commit_hash = raw_args[i + 1]
            i += 2
        else:
            remaining.append(raw_args[i])
            i += 1

    text = " ".join(remaining) if remaining else "—"

    is_log = (verb == "log")
    if not is_log and verb not in VALID_STATUSES:
        print(f"Error: status must be one of {sorted(VALID_STATUSES)} or 'log', got: {repr(verb)}", file=sys.stderr)
        sys.exit(1)

    script_dir = os.path.dirname(os.path.abspath(__file__))
    status_path = os.path.join(script_dir, "status.json")

    with open(status_path, "r", encoding="utf-8") as f:
        data = json.load(f)

    now = datetime.datetime.now()
    ts = now.isoformat(timespec="seconds")

    agents = data.get("agents", [])
    for agent in agents:
        if agent.get("name") == agent_name:
            history = agent.get("history") or []
            if is_log:
                # a flow note that does not change the agent's current status
                entry = {"ts": ts, "kind": "log", "status": agent.get("status", "idle"), "task": text}
            else:
                agent["status"] = verb
                agent["task"] = text
                entry = {"ts": ts, "kind": "status", "status": verb, "task": text}
            if commit_hash is not None:
                entry["commit"] = commit_hash
                agent["commit"] = commit_hash
            if tokens is not None:
                agent["tokens"] = tokens
            history.append(entry)
            if len(history) > HISTORY_CAP:
                history = history[-HISTORY_CAP:]
            agent["history"] = history
            break
    else:
        known = [a.get("name") for a in agents]
        print(f"Error: unknown agent {repr(agent_name)}. Known agents: {known}", file=sys.stderr)
        sys.exit(1)

    data["updated"] = now.date().isoformat()
    data["updatedAt"] = ts

    tmp_fd, tmp_path = tempfile.mkstemp(dir=script_dir, suffix=".json.tmp")
    try:
        with os.fdopen(tmp_fd, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)
            f.write("\n")
        os.replace(tmp_path, status_path)
    except Exception:
        os.unlink(tmp_path)
        raise

    print(f"[dashboard] {agent_name} → {'log' if is_log else verb}: {text}")

if __name__ == "__main__":
    main()
