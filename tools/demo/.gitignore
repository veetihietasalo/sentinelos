# Node / Remotion
node_modules/
.remotion/

# Rendered video output — regenerable, can be large. Keep the repo lean.
# (A small hero GIF MAY be force-added below if we want it in the README.)
out/

# Captured PNG frame sequence — regenerable via capture/capture_frames.sh.
# These are the real OS screendumps; large and reproducible, so not tracked.
frames/

# Frames are copied here for Remotion's staticFile(); never track the copy.
public/frames/

